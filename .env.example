# Speech-to-text (Scribe v2 Realtime) and the translated voice (Flash v2.5).
# Without it no room can start; the page says so and /api/status lists what is missing.
ELEVENLABS_API_KEY=

# Who may create rooms. Required: creating a room spends your ElevenLabs and Anthropic credit.
# A word or phrase of your choosing, asked for on the create page; or the word none to let anyone create rooms
# (fine on your own machine, not on a public address). Unset means rooms are refused, and the page says so.
# The people you invite do not need it: they join through the link you send.
ROOM_ACCESS_CODE=

# Where your ElevenLabs workspace lives. Built in as eu, so leave it empty for an EU workspace.
# Set in, sg or us for another data-residency workspace (address contains "residency"), or the word default
# for an ordinary account on api.elevenlabs.io. A key is rejected as invalid on the wrong region.
ELEVENLABS_REGION=

# The translation itself. Without it no room can start.
ANTHROPIC_API_KEY=

# Optional.
# Model for translation. Default claude-haiku-5-5: a sentence at a time, spoken as soon as it is ready.
TRANSLATE_MODEL=
# The voice the listener hears. Default is ElevenLabs' quickstart voice, a placeholder rather than a recommendation.
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
# Languages the voice model can speak, comma-separated codes (e.g. en,es,th). Default: Flash v2.5's 32, which has no Thai.
# A language outside it can still be READ: it arrives as text and the page says so. Set this when you switch to a model with more voices.
ELEVENLABS_VOICE_LANGUAGES=
ELEVENLABS_STT_MODEL=
# Minutes of speech one room may use (both people together) before it stops taking audio. Default 60.
# Speech-to-text is billed per hour of audio sent, so this is the ceiling on what one forgotten room costs.
ROOM_MAX_MINUTES=
PORT=
